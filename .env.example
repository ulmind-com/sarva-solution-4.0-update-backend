# ==============================================================================
# Sarva Solutions MLM System - Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' and modify the values for your environment.
# DO NOT commit the '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Settings (CRITICAL)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://user:pass@cluster.mongodb.net/dbname)
MONGO_URI=mongodb://localhost:27017/sarvasolution

# ------------------------------------------------------------------------------
# Authentication (CRITICAL)
# ------------------------------------------------------------------------------
# Secret key used to sign JWT tokens. Keep this long, secure, and private.
JWT_SECRET=your_super_secret_jwt_key_here

# ------------------------------------------------------------------------------
# Resend Email Integration (OPTIONAL but required for email delivery)
# ------------------------------------------------------------------------------
# API key from your Resend dashboard (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# Sender email address. Must be a domain verified in your Resend account.
# Defaults to 'onboarding@resend.dev' if not set.
MAIL_ADDRESS=info@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ------------------------------------------------------------------------------
# Cloudinary Image Upload Integration (OPTIONAL but required for KYC/avatar uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# APITxT OTP integration (phone verification on the public registration form)
# ------------------------------------------------------------------------------
APITXT_AUTHKEY=your_apitxt_auth_key
APITXT_BASE_URL=https://apitxt.com/api/sendOTP

# Optional: SMS channel + your pre-approved template id (DLT).
# If omitted, default OTP template configured in APITxT is used.
APITXT_CHANNEL=sms
# APITXT_TEMPLATE_ID=42

# Set to "false" to temporarily disable the server-side OTP gate on registration.
# Defaults to "true" (enabled) when unset.
# Pair it with VITE_OTP_VERIFICATION_REQUIRED=false on the frontend, otherwise the
# signup form still asks for an OTP and the SMS cost is still incurred.
OTP_VERIFICATION_REQUIRED=true

# ------------------------------------------------------------------------------
# Frontend Integration Settings
# ------------------------------------------------------------------------------
FRANCHISE_LOGIN_URL=https://www.yourdomain.com/franchise-login
